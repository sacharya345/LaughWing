PORT=3000
SITE_URL=https://your-domain.example
DATABASE_URL=postgres://postgres:your_password@localhost:5432/laughwing
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-this-with-a-strong-password

# Set to "email", "sms", "both", or "none".
NOTIFICATION_CHANNEL=none
ORDER_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio SMS settings (required when NOTIFICATION_CHANNEL is "sms" or "both").
ORDER_ALERT_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional. Set DATABASE_SSL=true when your PostgreSQL host requires TLS.
DATABASE_SSL=false
